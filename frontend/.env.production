# Production-mode config (loaded by `vite build` / mode=production).
#
# Requirement 6.1: the deployed backend API base URL is NOT hardcoded here.
# It is injected at build time from the deploy environment, e.g.:
#
#   VITE_API_BASE_URL=https://your-api-id.execute-api.your-region.amazonaws.com npm run build
#
# A real, shell/CI-provided VITE_API_BASE_URL takes precedence over this file.
# The variable is intentionally left empty below so that a production build
# with NO value supplied fails fast (see src/api/apiConfig.ts) rather than
# falling back to a localhost/HTTP default (Requirement 6.3).
#
# Do NOT commit a real deployed URL to this file.
VITE_API_BASE_URL=
