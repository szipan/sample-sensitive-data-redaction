# Development-mode config (loaded by `vite dev` / mode=development).
#
# Reasonable local default so `vite dev` works out of the box against a
# locally-running / port-forwarded backend. Override per machine via
# `.env.local` (git-ignored). Must be https:// (Requirement 6.3).
#
# Note: if this were unset, development mode still falls back to
# https://localhost:4000 (see src/api/apiConfig.ts). Production mode has no
# such fallback and requires VITE_API_BASE_URL explicitly.
VITE_API_BASE_URL=https://your-api-id.execute-api.your-region.amazonaws.com
